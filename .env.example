# Afiliados IA — variáveis do servidor
# NUNCA coloque valores reais neste arquivo ou no GitHub.

# OAuth Mercado Livre
ML_CLIENT_ID=
ML_CLIENT_SECRET=
ML_REDIRECT_URI=https://choose-plan.onrender.com/auth/mercadolivre/callback

# Chave usada para proteger as sessões OAuth do app
SESSION_SECRET=

# Provedor de IA (compatível com endpoint HTTP que aceite Authorization: Bearer)
AI_API_URL=
AI_API_KEY=

# Shopee — preencher quando a integração oficial/API disponível estiver configurada
SHOPEE_API_URL=
SHOPEE_API_KEY=
